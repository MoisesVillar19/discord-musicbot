# Copia este archivo como `.env` y pon tus valores reales.
# NUNCA subas `.env` a GitHub (ya está en .gitignore).
DISCORD_TOKEN=pega_aqui_tu_token_de_discord
# Nombre visible del bot en mensajes y /help (opcional).
BOT_NAME=MusicBot
# Servidor de desarrollo (opcional): ID numérico para sync instantáneo de slash.
# Sin GUILD_ID el sync es global y tarda hasta ~1 h en propagar.
GUILD_ID=
# Probabilidad (0.0-1.0) de emboscada troll en /play por texto. 0 = off.
TROLL_CHANCE=0.05
# Rol DJ (opcional): ID del rol para comandos sensibles. Vacío = todos pueden.
DJ_ROLE_ID=
# Nivel de log: DEBUG, INFO, WARNING o ERROR.
LOG_LEVEL=INFO
# Segundos solo antes de irse si el canal queda vacío (mínimo 15).
EMPTY_TIMEOUT=120
