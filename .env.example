# Copia este archivo como `.env` y pon tus valores reales.
# NUNCA subas `.env` a GitHub (ya está en .gitignore).
DISCORD_TOKEN=pega_aqui_tu_token_de_discord
# Nombre visible del bot en mensajes y /help (opcional).
BOT_NAME=MusicBot
# Servidor de desarrollo (opcional): ID numérico para sync instantáneo de slash.
# Sin GUILD_ID el sync es global y tarda hasta ~1h en propagar.
GUILD_ID=
